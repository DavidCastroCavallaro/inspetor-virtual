# ===== Inspetor Virtual - Backend =====
# Deixe as chaves VAZIAS para rodar em MODO MOCK (simulacao, custo zero).
# Preencha qualquer uma para ativar IA real.

PORT=8787

# Roteamento inteligente: modelo barato primeiro, caro so como fallback (<80% confianca)
AI_PROVIDER=auto            # auto | gemini | anthropic | mock

# Google Gemini (OCR/visao rapido e barato: gemini-1.5-flash)
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-1.5-flash
GEMINI_MODEL_FALLBACK=gemini-1.5-pro

# Anthropic Claude (rapido/barato: claude-haiku-4-5; fallback alta confianca: claude-sonnet-4-6)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_FAST=claude-haiku-4-5
ANTHROPIC_MODEL_FALLBACK=claude-sonnet-4-6

# OpenAI (transcricao de voz Whisper)
OPENAI_API_KEY=
OPENAI_WHISPER_MODEL=whisper-1

# Limiar de confianca para acionar fallback caro (0-1)
CONFIDENCE_THRESHOLD=0.8
